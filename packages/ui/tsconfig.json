{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react"]
  },
  "references": [
    { "path": "../client" },
    { "path": "../protocol" }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
